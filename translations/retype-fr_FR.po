#. Plugin Name of the plugin
#: retype.php build/editor.js:1
msgid "Retype"
msgstr "Retype"

#. Plugin URI of the plugin
#: retype.php
msgid "https://github.com/Fyrins/retype"
msgstr "https://github.com/Fyrins/retype"

#. Description of the plugin
#: retype.php
msgid ""
"A rich text format for the block editor. Select a word, list a few "
"alternatives, and on the front end the word is erased and typed again, "
"letter by letter, cycling through the list."
msgstr ""
"Un format de texte riche pour l’éditeur de blocs. Sélectionnez un mot, "
"indiquez quelques variantes, et sur le site le mot s’efface puis se retape, "
"lettre par lettre, en parcourant la liste."

#. Author of the plugin
#: retype.php
msgid "Alexandre Revire"
msgstr "Alexandre Revire"

#. Author URI of the plugin
#: retype.php
msgid "https://alexandre-revire.fr"
msgstr "https://alexandre-revire.fr"

#: build/editor.js:1
msgid "Words to type, separated by commas"
msgstr "Mots à taper, séparés par des virgules"

#: build/editor.js:1
msgid "The selected word shows first, then each word of the list, in a loop."
msgstr ""
"Le mot sélectionné s’affiche en premier, puis chaque mot de la liste, en "
"boucle."

#: build/editor.js:1
msgid "Typing delay per letter (ms)"
msgstr "Délai de frappe par lettre (ms)"

#. translators: %d: default delay per typed letter, in milliseconds.
#: build/editor.js:2
msgid "Lower is faster, and erasing follows in proportion. Default: %d ms."
msgstr "Plus la valeur est basse, plus la frappe est rapide, et l’effacement suit en proportion. Par défaut : %d ms."

#: build/editor.js:2
msgid "Pause on each word (s)"
msgstr "Pause sur chaque mot (s)"

#. translators: %s: default pause on each word, in seconds.
#: build/editor.js:3
msgid "Default: %s s."
msgstr "Par défaut : %s s."

#: build/editor.js:3
msgid "Caret color"
msgstr "Couleur du curseur"

#: build/editor.js:3
msgid "Without a color, the caret takes the color of the text."
msgstr "Sans couleur, le curseur prend la couleur du texte."

#: build/editor.js:3
msgid "Apply"
msgstr "Appliquer"

#: build/editor.js:3
msgid "Remove format"
msgstr "Retirer le format"
